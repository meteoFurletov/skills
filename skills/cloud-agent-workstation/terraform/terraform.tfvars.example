# cp terraform.tfvars.example terraform.tfvars  — and gitignore the real file.
# Nothing here is secret (a public key is public), but tfvars is where secrets
# would land if the config ever grows, so keep the habit.

ssh_public_key = "ssh-ed25519 AAAA... you@host"

# name              = "workstation"
# aws_region        = "eu-central-1"
# instance_type     = "t3.medium"
# root_volume_size  = 50
# swap_size_mb      = 4096

# Tighten once you know where you connect from:
# allowed_ssh_cidrs = ["203.0.113.4/32"]
